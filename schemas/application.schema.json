{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://meldritch.dev/contracts/lua/application.schema.json",
  "title": "Meldritch Lua application manifest",
  "type": "object",
  "required": ["name", "version", "entry", "lua_host_api", "capabilities"],
  "properties": {
    "name": {"type": "string", "minLength": 1},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "entry": {"type": "string", "pattern": "^[^/].*\\.lua$"},
    "lua_host_api": {"type": "string", "minLength": 1},
    "capabilities": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "libraries": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "assets": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "requirements": {"type": "object", "additionalProperties": true}
  },
  "additionalProperties": false
}
